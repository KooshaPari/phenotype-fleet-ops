# phenotype-review-surface Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Secrets are managed via Infisical (see ../.github/workflows/infisical.yml).
# This file documents ALL env vars the service reads. In production, secrets
# are injected at runtime by the Infisical CLI — do NOT commit real values.
# ──────────────────────────────────────────────────────────────────────────────

# Infisical (production secret injection)
# The container ENTRYPOINT uses these to pull secrets before starting uvicorn.
INFISICAL_TOKEN=st.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INFISICAL_PROJECT_ID=8efe392e-56a6-4c3c-89f9-8141183dd7e8
INFISICAL_ENV=prod  # one of: prod | staging | dev

# GitHub (required — stored in Infisical)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_WEBHOOK_SECRET=your-webhook-secret-from-github-settings

# Backend API Keys (optional — stored in Infisical, one per backend)
CODERABBIT_TOKEN=coderabbit_xxxxxxxxxxxxxxxxxxxxxxxx
CURSOR_WEBHOOK_URL=http://cursor-server:3000/api/review

# Redis (for production state persistence — stored in Infisical)
REDIS_URL=redis://localhost:6379/0

# Review Configuration (non-secret, can be set directly)
REVIEW_TOOL_BACKENDS=forge,coderabbit,copilot,cursor
REVIEW_DEFAULT_BACKEND=forge
REVIEW_RATE_LIMIT_PER_HOUR=30

# Server (non-secret, can be set directly)
REVIEW_PORT=8080
REVIEW_LOG_LEVEL=info