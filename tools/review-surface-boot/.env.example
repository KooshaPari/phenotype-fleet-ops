# Review-Surface Secrets — fill in once, deploy to all 11 fleet repos.
#
# After the review-surface API is deployed somewhere reachable from GitHub Actions:
#   REVIEW_SURFACE_URL  - public HTTPS URL of the review-surface service
#   REVIEW_SURFACE_TOKEN - shared bearer token (>= 32 bytes of random entropy)
#
# Generate a strong token:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Required permissions on the GitHub PAT / gh auth used to set secrets:
#   - repo scope (for repo-level secrets), OR
#   - admin:org + manage_repo_secrets scope (for org-level secrets)
#
# Usage:
#   cp .env.example .env
#   $EDITOR .env                       # fill in real values
#   ./set-fleet-secrets.sh --from-env  # apply to all 11 fleet repos

REVIEW_SURFACE_URL=https://review.phenotype.example
REVIEW_SURFACE_TOKEN=replace-me-with-48-bytes-of-random
